# Safety first: true means the bot logs signals but does NOT place trades.
BOT_DRY_RUN=true

# Your broker may use a different symbol name, e.g. US500, SPX500.cash, US500.cash
BOT_SYMBOL=SPX500

# Risk settings
BOT_RISK_PERCENT=1.0
BOT_MAX_TRADES_PER_DAY=3
BOT_MAX_SPREAD_POINTS=50
BOT_STOP_LOSS_POINTS=250
BOT_TAKE_PROFIT_POINTS=500

# Bot loop
BOT_POLL_SECONDS=10
BOT_CANDLES=120

# Output log
BOT_LOG_FILE=trades.csv
